# Required for real AI responses. Create a key at https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
ULTRON_AVAILABLE_MODELS=openrouter/free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free
# Optional comma-separated OpenRouter vision model IDs; tried first for image chats
ULTRON_VISION_MODELS=openrouter/free,nvidia/nemotron-3.5-super-vl:free
# Overall deadline for each chat request; individual providers time out while waiting for response headers.
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_ATTEMPT_TIMEOUT_MS=15000
# Overall deadline for each model-provider fallback chain (15-120 seconds; default 90s).
ULTRON_MODEL_TOTAL_TIMEOUT_MS=90000

# Optional ordered OpenAI-compatible fallback providers for normal chat and agent tools.
# Keep each provider API key in the host's secret environment, never in this file or browser code.
# Example structure (replace the URL/model/key-env with a real provider configuration):
# SECONDARY_CHAT_API_KEY=
# ULTRON_MODEL_PROVIDERS_JSON=[{"name":"secondary","baseUrl":"https://api.example.com/v1","apiKeyEnv":"SECONDARY_CHAT_API_KEY","model":"provider/model-id","priority":10,"supportsVision":false}]
ULTRON_MODEL_PROVIDERS_JSON=[{"name":"nemotron-lightning-free","baseUrl":"https://openrouter.ai/api/v1","apiKeyEnv":"OPENROUTER_API_KEY","model":"nvidia/nemotron-3.5-lightning:free","priority":10,"supportsTools":true},{"name":"north-mini-code-free","baseUrl":"https://openrouter.ai/api/v1","apiKeyEnv":"OPENROUTER_API_KEY","model":"cohere/north-mini-code:free","priority":20,"supportsTools":true}]

# Supabase Auth and per-user conversation persistence. The publishable key is safe for client-facing use;
# never add a service-role key to browser code or commit secrets.
SUPABASE_URL=https://opdjfhwepmcprbqojpat.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# OAuth and recovery redirects must be HTTPS in production and allow-listed in Supabase Auth.
# Google callback URL must end with /api/auth/google/callback and exactly match ULTRON's public origin.
ULTRON_AUTH_CALLBACK_URL=
ULTRON_AUTH_REDIRECT_URL=

# Optional legacy owner-only access gate (not required for Supabase account login).
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional external capability adapters. These are readiness settings only; configure only
# after deploying and securing each separate service.

# Optional owner-scoped read-only productivity APIs. Never commit real tokens.
# Required guard: set ULTRON_INTEGRATION_OWNER_USER_ID to the owner's exact Supabase Auth UUID.
# Without a matching signed-in user, these shared service credentials are blocked.

# Optional Obscura browser adapter (Rust headless browser + MCP).
# The MCP service must be started separately with "obscura mcp --http --port 8080".
# Use loopback when co-hosted. For a remote endpoint, put it behind an HTTPS gateway
# that validates OBSCURA_MCP_TOKEN; do not expose a raw unauthenticated MCP endpoint.
OBSCURA_MCP_URL=
OBSCURA_MCP_TOKEN=

# Optional Cactus local model provider. Run "cactus serve <installed-model> --no-cloud-handoff"
# separately; this setting never downloads weights. Local loopback HTTP is allowed only
# when ULTRON and Cactus run on the same host. Render cannot reach a PC's localhost.
# A remote Cactus service must use HTTPS and a gateway that validates CACTUS_API_KEY.
CACTUS_BASE_URL=
CACTUS_MODEL=
CACTUS_API_KEY=
CACTUS_LOCAL_FIRST=true
CACTUS_CONFIDENCE_THRESHOLD=0.72
CACTUS_SUPPORTS_TOOLS=true
# Keep false unless cloud handoff is explicitly configured, paid usage is understood,
# and the privacy policy has been reviewed. Start Cactus with --no-cloud-handoff by default.
CACTUS_ALLOW_CLOUD_HANDOFF=false
ULTRON_INTEGRATION_OWNER_USER_ID=
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
OPENPROJECT_BASE_URL=
OPENPROJECT_API_TOKEN=
CALDIY_BASE_URL=
CALDIY_API_TOKEN=
CALDIY_API_VERSION=2026-02-25

# Optional Paperclip agent-organization/read-only governance connector.
# Deploy Paperclip separately; use its HTTPS origin and a scoped bearer API token.
# The owner UUID guard must match the ULTRON signed-in Supabase auth user.
# ULTRON reads agent roster, dashboard and cost summary only; no agent lifecycle or budget writes.
PAPERCLIP_BASE_URL=
PAPERCLIP_API_TOKEN=
PAPERCLIP_COMPANY_ID=

# Optional Hermes Agent API bridge. Install/configure Hermes separately and run its authenticated API server.
# Remote endpoint must use HTTPS; keep Hermes toolsets least-privileged and terminal backend sandboxed.
# Delegated task tools require the owner UUID; direct normal-chat routing is a separate opt-in.
HERMES_AGENT_ENABLED=false
HERMES_AGENT_CHAT_PROVIDER=false
HERMES_AGENT_BASE_URL=
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
HERMES_AGENT_PRIORITY=-5
HERMES_AGENT_SUPPORTS_VISION=true
HERMES_AGENT_TIMEOUT_SECONDS=90
HERMES_AGENT_MAX_PROMPT_CHARS=8000
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
HEYGEM_API_BASE_URL=
HEYGEM_API_KEY=
HEYGEM_JOB_PATH=
OMNIVOICE_API_BASE_URL=
OMNIVOICE_API_KEY=
OMNIVOICE_SYNTHESIS_PATH=
ULTRON_HANDY_BRIDGE_URL=
ULTRON_HANDY_BRIDGE_TOKEN=
ULTRON_HANDY_TRANSCRIBE_PATH=
ULTRON_EMPLOYEES_ENABLED=false

# Optional local inference endpoint (Ollama). On Render this must be a reachable hosted endpoint;
# a PC-local Ollama requires the authenticated Windows companion/bridge.
OLLAMA_BASE_URL=
LOCAL_MODEL_TIMEOUT_SECONDS=90

# Optional research provider; without a key, ULTRON uses a public HTML search fallback
# that may be rate-limited or change without notice.
TAVILY_API_KEY=

# Optional VoiceStudio integration. Install/run VoiceStudio separately (default local API: http://localhost:3900).
# Render cannot reach a PC's localhost. For remote use, configure a secured HTTPS endpoint and its API key.
VOICESTUDIO_BASE_URL=
VOICESTUDIO_API_KEY=

# Optional premium speech adapters (implement provider-compatible endpoints separately).
TTS_API_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_DEFAULT_VOICE=alloy
STT_API_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Optional authenticated Windows companion bridge; never expose these values to the browser.
ULTRON_DESKTOP_AGENT_URL=
ULTRON_DESKTOP_AGENT_TOKEN=
# Dedicated 32+ character high-entropy token shared only by the backend and paired Windows companion.
# This does not replace user authentication or the action allowlist.
ULTRON_DESKTOP_BRIDGE_TOKEN=
# Optional hands-free mode for only Notepad, Calculator, Explorer, or bounded system info.
# Leave unset for per-action approval; set to allowlisted only after pairing/testing the owner PC.
ULTRON_DESKTOP_AUTONOMY_MODE=

# Optional background task worker. Keep the service-role key server-side only.
# Apply supabase/migrations/202610220001_task_worker.sql before running the worker.
SUPABASE_SERVICE_ROLE_KEY=
ULTRON_WORKER_POLL_MS=5000

# Server
NODE_ENV=development
PORT=10000
MAX_MESSAGE_CHARS=12000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Optional AgentMemory persistent memory service (separate service; server-side only).
AGENTMEMORY_URL=
AGENTMEMORY_SECRET=
ULTRON_AGENTMEMORY_PROJECT=ultron-ai
# Set false to disable bounded capture of explicit durable decisions/preferences.
ULTRON_AGENTMEMORY_CAPTURE=true

# Optional interactive browser automation; deploy browser-use-bridge separately.
# The bridge can reuse ULTRON's key via this authenticated, OpenAI-compatible gateway.
# Set only in the bridge service; keep the shared token server-side and out of browser code.
ULTRON_MODEL_GATEWAY_BASE_URL=
ULTRON_BROWSER_USE_URL=
ULTRON_BROWSER_USE_TOKEN=

# Optional OpenViking context database adapter. Read-only; owner scoped.
OPENVIKING_BASE_URL=
OPENVIKING_API_TOKEN=

# Restricted, owner-only code execution (off by default). Images must already be cached locally and pinned by SHA-256 digest.
ULTRON_CODING_SANDBOX_ENABLED=false
ULTRON_CODING_SANDBOX_NODE_IMAGE=
ULTRON_CODING_SANDBOX_PYTHON_IMAGE=
ULTRON_CODING_SANDBOX_TIMEOUT_MS=5000
ULTRON_CODING_SANDBOX_DOCKER_BIN=docker
