# Required for real AI responses
NARA_ROUTER_BASE_URL=https://openrouter.ai/api/v1
NARA_ROUTER_API_KEY=
NARA_ROUTER_DEFAULT_MODEL=poolside/laguna-s-2.1:free
ULTRON_AVAILABLE_MODELS=poolside/laguna-s-2.1:free,minimax/minimax-m3.1-flash:free,nvidia/nemotron-3.5-lightning:free
NARA_ROUTER_TIMEOUT_SECONDS=60

# Supabase Auth and per-user conversation persistence. The publishable key is safe for client-facing use;
# never add a service-role key to browser code or commit secrets.
SUPABASE_URL=https://opdjfhwepmcprbqojpat.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional legacy owner-only access gate (not required for Supabase account login).
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Server
NODE_ENV=development
PORT=10000
MAX_MESSAGE_CHARS=12000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
