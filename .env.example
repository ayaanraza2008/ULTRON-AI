# Required for real AI responses
NARA_ROUTER_BASE_URL=https://router.bynara.id/v1
NARA_ROUTER_API_KEY=
NARA_ROUTER_DEFAULT_MODEL=
NARA_ROUTER_TIMEOUT_SECONDS=60

# Required access gate for the initial single-owner web foundation.
# Use a long random password; configure as a secret in hosting.
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Server
NODE_ENV=development
PORT=10000
MAX_MESSAGE_CHARS=12000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
