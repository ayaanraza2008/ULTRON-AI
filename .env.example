# Required for real AI responses. Create a key at https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
ULTRON_AVAILABLE_MODELS=openrouter/free
# Optional comma-separated OpenRouter vision model IDs; tried first for image chats
ULTRON_VISION_MODELS=
OPENROUTER_TIMEOUT_SECONDS=60

# Supabase Auth and per-user conversation persistence. The publishable key is safe for client-facing use;
# never add a service-role key to browser code or commit secrets.
SUPABASE_URL=https://opdjfhwepmcprbqojpat.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional legacy owner-only access gate (not required for Supabase account login).
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional external capability adapters. These are readiness settings only; configure only
# after deploying and securing each separate service.
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
HEYGEM_API_BASE_URL=
HEYGEM_API_KEY=
HEYGEM_JOB_PATH=
OMNIVOICE_API_BASE_URL=
OMNIVOICE_API_KEY=
OMNIVOICE_SYNTHESIS_PATH=
ULTRON_HANDY_BRIDGE_URL=
ULTRON_HANDY_BRIDGE_TOKEN=
ULTRON_HANDY_TRANSCRIBE_PATH=
ULTRON_EMPLOYEES_ENABLED=false

# Optional local inference endpoint (Ollama). On Render this must be a reachable hosted endpoint;
# a PC-local Ollama requires the authenticated Windows companion/bridge.
OLLAMA_BASE_URL=
LOCAL_MODEL_TIMEOUT_SECONDS=90

# Optional research provider; without a key, ULTRON uses a public HTML search fallback
# that may be rate-limited or change without notice.
TAVILY_API_KEY=

# Optional premium speech adapters (implement provider-compatible endpoints separately).
TTS_API_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_DEFAULT_VOICE=alloy
STT_API_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Optional authenticated Windows companion bridge; never expose these values to the browser.
ULTRON_DESKTOP_AGENT_URL=
ULTRON_DESKTOP_AGENT_TOKEN=

# Optional background task worker. Keep the service-role key server-side only.
# Apply supabase/migrations/202610220001_task_worker.sql before running the worker.
SUPABASE_SERVICE_ROLE_KEY=
ULTRON_WORKER_POLL_MS=5000

# Server
NODE_ENV=development
PORT=10000
MAX_MESSAGE_CHARS=12000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Optional AgentMemory service for task-aware persistent recall.
# Hosted ULTRON needs a reachable HTTPS AgentMemory URL; do not use localhost on Render.
AGENTMEMORY_URL=
AGENTMEMORY_SECRET=
ULTRON_AGENTMEMORY_PROJECT=ultron-ai
# Durable-context capture is opt-in; automatic recall remains task-aware when configured.
ULTRON_AGENTMEMORY_CAPTURE=false
